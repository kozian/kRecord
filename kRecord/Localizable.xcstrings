        }
      }
    },
    "Echo cancellation removes sound from your speakers that the microphone picks up. Other audio may be quieter while it is on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эхоподавление убирает звук из ваших колонок, который улавливает микрофон. Пока оно включено, остальной звук может быть тише."
          }
        }
      }
    },
